generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  cpf       String   @unique
  birthDate DateTime
  phone     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pessoa")
}
